import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Geode 新手模组清单：稳定优先的筛选流程（无假排名）" description="Geode 新手怎么选 mod：先定目的 → 核对 GD/Geode/平台兼容 → 一个一个装并测试。对接官方 Mods Browser；本站不编造必装榜或评分。">
  <section class="hero"><div class="container narrow"><p class="eyebrow">No fake rankings</p><h1>新手模组清单：先少，再稳。</h1><p>本站不编造下载量、评分或「必装 mod」名单。用这个流程从官方浏览器选择适合你的模组。</p><p class="note">有人搜「best geode mods」想要一份必装榜。本站只提供稳定优先的筛选流程，并链到官方 Mods Browser——因为假排名会在版本更新后害人崩游戏。</p></div></section>
  <section class="section"><div class="container grid"><article class="card"><b>01 · 先确定目的</b><h2>玩家 / 练习 / 创作</h2><p>一次只解决一个需求：界面便利、练习辅助或编辑器工作流。</p></article><article class="card"><b>02 · 看兼容性</b><h2>版本与平台优先</h2><p>确认当前 GD、Geode 和你的 Windows / macOS / Android / iOS 环境都在支持范围内。核验方法见 <a href="/compatibility">/compatibility</a>。</p></article><article class="card"><b>03 · 小步验证</b><h2>一个一个装</h2><p>每安装一个就启动一次；把模组名称记下来，方便 Safe Mode 回退（见 <a href="/#crash">/#crash</a>）。</p></article></div></section>
  <section class="section shaded"><div class="container narrow"><h2>按意图在官方浏览器搜索</h2><p>下面只写<strong>功能意图</strong>，不点名虚构「必装 mod」：在官方 Mods Browser 自行搜索并核验版本与平台。</p><ul class="cats"><li><strong>界面 / 生活质量</strong> — 搜索后读版本与平台说明，装一个测一个。</li><li><strong>练习辅助</strong> — 勿用于不当排行榜/验证场景；遵守社区规则。</li><li><strong>编辑器 / 创作工作流</strong> — 确认维护状态与 GD 版本匹配后再装。</li></ul><p class="cta"><a class="btn btn-accent" href="https://geode-sdk.org/mods" target="_blank" rel="noopener">到官方 Mods Browser 开始筛选</a></p><p class="soft"><a href="/mods">选模说明</a> · <a href="/compatibility">版本兼容</a> · <a href="/install">安全安装</a> · <a href="/#crash">Safe Mode 急救</a></p></div></section>
</BaseLayout>
<style>.hero{text-align:center;padding:5rem 0;background:linear-gradient(180deg,var(--color-bg-secondary),var(--color-bg))}.narrow{max-width:760px}.hero p{color:var(--color-text-muted);font-size:1.1rem}.note{margin-top:1rem;font-size:1rem!important}.eyebrow{color:var(--color-accent);font-size:.8rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em}.grid{grid-template-columns:repeat(3,1fr)}.card>b{color:var(--color-accent)}.card h2{margin:.6rem 0}.card p{color:var(--color-text-muted)}.shaded{background:var(--color-bg-secondary)}.cats{text-align:left;margin:1.25rem 0;padding-left:1.25rem;color:var(--color-text-muted)}.cats li{margin:.6rem 0}.cta{text-align:center;margin-top:1.5rem}.soft{text-align:center;margin-top:1rem;color:var(--color-text-muted)}@media(max-width:768px){.grid{grid-template-columns:1fr}}</style>
